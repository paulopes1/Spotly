# ── Banco de dados ────────────────────────────────────────────────
DATABASE_URL="postgresql://spotly:spotly@localhost:5432/spotly?schema=public"

# ── Auth (troque em produção por valores longos e aleatórios) ─────
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

# ── OpenAI (opcional no MVP) ──────────────────────────────────────
# Sem esta chave o backend usa o parser determinístico + gerador de
# prós/contras baseado em templates. Preencha para ativar o GPT-4o.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ── Pexels (opcional) ─────────────────────────────────────────────
# Sem esta chave o seed usa placeholders (picsum.photos). Preencha para
# popular os imóveis com fotos reais de bancos gratuitos, filtradas por
# tipo de imóvel. Chave grátis e aprovação instantânea em pexels.com/api.
PEXELS_API_KEY=""

# ── App ───────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
